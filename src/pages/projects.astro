---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Projects | Leihaopam Leisan">
    <article id="projects" class="project-card">
        <h2>My Projects</h2>

        <h3>Personal Portfolio Website</h3>

        <p>
            This project demonstrates my HTML5, CSS, and JavaScript skills.
        </p>

        <a
            href="https://github.com/Appam23?tab=repositories"
            target="_blank"
            rel="noopener noreferrer"
        >
            View My GitHub Repository Projects
        </a>

        <br>

        <button id="projectButton" type="button">
            Change Project
        </button>

        <p id="projectStatus">
            Click the button to view another project title.
        </p>
    </article>

    <section class="featured-projects" aria-labelledby="featured-projects-title">
        <h2 id="featured-projects-title">Featured Professional Work</h2>
        <p>
            These real-world projects reflect my experience supporting live websites
            through design, content, and ongoing maintenance.
        </p>

        <div class="project-grid">
            <article class="featured-project">
                <h3>
                    <a
                        href="https://icongaming.us/"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        ICON Gaming Website
                    </a>
                </h3>
                <p><strong>Role:</strong> Web Design &amp; Development Intern</p>
                <p><strong>Platform:</strong> WordPress</p>
                <p>
                    Website updates, content editing, page design, layout improvements,
                    and maintenance.
                </p>
            </article>

            <article class="featured-project">
                <h3>
                    <a
                        href="https://radiohex.com/"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        Radio Hex
                    </a>
                </h3>
                <p><strong>Role:</strong> Web Design &amp; Development Intern</p>
                <p><strong>Platform:</strong> WordPress</p>
                <p>Event management and website content updates.</p>
            </article>

            <article class="featured-project">
                <h3>
                    <a
                        href="https://scoremedicare.com/"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        Score Medicare
                    </a>
                </h3>
                <p><strong>Role:</strong> Web Design &amp; Development Intern</p>
                <p>Website content and page updates.</p>
            </article>
        </div>
    </section>

    <script src="/script.js" defer></script>
</Layout>