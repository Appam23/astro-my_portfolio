---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Projects | Leihaopam Leisan">
    <article id="projects" class="project-card">
        <h2>My Projects</h2>

        <h3>Personal Portfolio Website</h3>

        <p>
            This project demonstrates my HTML5, CSS, and JavaScript skills.
        </p>

        <a
            href="https://github.com/Appam23?tab=repositories"
            target="_blank"
            rel="noopener noreferrer"
        >
            View My GitHub Repository Projects
        </a>

        <br>

        <button id="projectButton" type="button">
            Change Project
        </button>

        <p id="projectStatus">
            Click the button to view another project title.
        </p>
    </article>

    <script src="/script.js" defer></script>
</Layout>